# Stored exactly as written: the gateway downloads these files raw (no
# checkout), so the repo must hold the line endings each platform needs.
# Windows batch files: CRLF.  Shell scripts: LF.
*.cmd  -text
*.sh   -text
# Python: LF, as the shebang line needs.
*.py   -text
# The signed add-on list: the signature covers these exact bytes.
catalogue.txt -text
catalogue.sig -text
